# PartSourcer backend settings (copy to .env to override defaults).
# All values below are the built-in defaults; none are required for v1.

# Upstream jlcsearch API base URL (consumed by the datasource phase)
JLCSEARCH_BASE_URL=https://jlcsearch.tscircuit.com

# Cache TTLs in seconds. STOCK_CACHE_TTL_SECS also governs how long the
# matcher's candidate pool is held. SPECS_CACHE_TTL_SECS is unused, a leftover
# from the v1 cache layer.
SPECS_CACHE_TTL_SECS=2592000
STOCK_CACHE_TTL_SECS=3600
# Cache rows older than this are deleted once at startup. Nothing evicts on
# its own, which only matters where the volume is real (Fly, not Render free).
CACHE_PRUNE_AFTER_DAYS=7

# SQLite cache DB path (consumed by the caching phase)
SQLITE_PATH=./partsourcer.db

# CORS allowed origins, JSON list (consumed by the harden phase)
CORS_ORIGINS=["*"]

# Outbound HTTP timeout in seconds (consumed by the datasource phase)
REQUEST_TIMEOUT_SECS=10.0

# History recorder (SP2a). Both are optional and both are secrets: never
# commit the filled-in .env. With DATABASE_URL unset the app behaves exactly
# as it did before SP2a, and POST /api/internal/record returns 503.
# DATABASE_URL is the Neon pooled connection string.
# RECORDER_TOKEN is the shared secret the nightly cron sends as
# X-Recorder-Token; generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DATABASE_URL=
RECORDER_TOKEN=

# Recorder batch size and outbound concurrency (safe defaults, rarely changed)
RECORDER_BATCH_SIZE=500
RECORDER_CONCURRENCY=4

# Distributors (SP1). Leave blank to keep that distributor disabled.
# A distributor with no credentials reports state="disabled" and is never
# called, so an empty file here reproduces today's LCSC-only behaviour.
MOUSER_API_KEY=
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
